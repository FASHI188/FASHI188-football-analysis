{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "football3://governance/formal-wiring-contract-schema-v2",
  "title": "Football3 Historical XG Fusion V2 Non-Market Formal Wiring Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "contract_kind",
    "branch",
    "status",
    "research_acceptance",
    "frozen_v1",
    "fusion",
    "runtime",
    "governance",
    "forbidden"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "project_id": {"const": "football3"},
    "contract_kind": {"const": "historical_xg_fusion_v2_formal_wiring_non_market"},
    "branch": {"const": "football3/historical-xg-fusion-v2-formal-wiring-governed-v1"},
    "status": {"const": "GOVERNANCE_REMEDIATED_PENDING_CODEX_RECHECK"},
    "research_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "head", "run_id", "artifact_id", "codex"],
      "properties": {
        "branch": {"const": "football3/historical-xg-fusion-v2"},
        "head": {"const": "d3b3e322f78c48b91477ef6e11054e51ac00fd85"},
        "run_id": {"const": 33581218312},
        "artifact_id": {"const": 9828471485},
        "codex": {"const": "CODEX_PASS"}
      }
    },
    "frozen_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "engine_sha256"],
      "properties": {
        "head": {"const": "22f639304d2e32fc952dbec2255153ee45dcd41a"},
        "engine_sha256": {"const": "cc2c2c3eca421ad6d277107b8f1212656b2e943cc179e7f394ac53e916c3f318"}
      }
    },
    "fusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xg_weight", "v1_weight", "formula", "score_matrix_lift", "xg_insufficient"],
      "properties": {
        "xg_weight": {"const": 0.75},
        "v1_weight": {"const": 0.25},
        "formula": {"const": "normalize((1-w)*p_V1 + w*p_XG)"},
        "score_matrix_lift": {"type": "string", "minLength": 1},
        "xg_insufficient": {"const": "FROZEN_V1_EXACT_FALLBACK"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_entry", "formal_enablement", "production_pointer_changed", "prospective_queue", "historical_completed_only_for_acceptance"],
      "properties": {
        "candidate_entry": {"const": "football-data/new_engine_v1/formal_fusion_v2.py"},
        "formal_enablement": {"const": false},
        "production_pointer_changed": {"const": false},
        "prospective_queue": {"const": false},
        "historical_completed_only_for_acceptance": {"const": true}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "market_features", "market_inputs", "market_baseline", "market_validator_semantics",
        "training", "tuning", "new_target_labels", "existing_frozen_historical_replay_only",
        "same_kickoff_isolation_required", "formal_enablement", "production_pointer_change",
        "whitelist_base_head", "changed_file_whitelist", "scientific_code_bindings",
        "immutable_market_governance_git_blobs", "immutable_formal_source_git_blobs"
      ],
      "properties": {
        "mode": {"const": "FORMAL_WIRING_NON_MARKET"},
        "market_features": {"const": false},
        "market_inputs": {"type": "array", "maxItems": 0},
        "market_baseline": {"const": false},
        "market_validator_semantics": {"const": "UNCHANGED_AND_NOT_APPLICABLE_TO_NON_MARKET_FORMAL_WIRING"},
        "training": {"const": false},
        "tuning": {"const": false},
        "new_target_labels": {"const": false},
        "existing_frozen_historical_replay_only": {"const": true},
        "same_kickoff_isolation_required": {"const": true},
        "formal_enablement": {"const": false},
        "production_pointer_change": {"const": false},
        "whitelist_base_head": {"const": "d3b3e322f78c48b91477ef6e11054e51ac00fd85"},
        "changed_file_whitelist": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string"}},
        "scientific_code_bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runner", "helpers", "contract_marker", "helper_marker", "authority_guard", "cumulative_audit_base_head"],
          "properties": {
            "runner": {"const": "football-data/new_engine_v1/formal_fusion_v2.py"},
            "helpers": {"const": ["football-data/new_engine_v1/test_formal_fusion_v2.py"]},
            "contract_marker": {"const": "FOOTBALL3_FORMAL_WIRING_CONTRACT"},
            "helper_marker": {"const": "FOOTBALL3_FORMAL_WIRING_HELPER_FOR"},
            "authority_guard": {"const": "football-data/research/audit_football3_changed_scientific_files.py"},
            "cumulative_audit_base_head": {"const": "d3b3e322f78c48b91477ef6e11054e51ac00fd85"}
          }
        },
        "immutable_market_governance_git_blobs": {"type": "object", "minProperties": 4},
        "immutable_formal_source_git_blobs": {"type": "object", "minProperties": 2}
      }
    },
    "forbidden": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
