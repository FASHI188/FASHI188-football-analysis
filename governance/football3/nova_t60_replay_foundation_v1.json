{
  "schema_version": "football3-nova-t60-replay-foundation-v1",
  "project_id": "football3",
  "status": "DESIGN_LOCKED_FOUNDATION_NOT_ENABLED",
  "research_only": true,
  "activation": {
    "enabled": false,
    "replay_coverage_start_at": null,
    "enablement_requires_explicit_future_authorization": true,
    "pre_enablement_fixtures_guaranteed": false
  },
  "coverage": {
    "initial_competitions": ["EPL", "La_liga", "Bundesliga", "Serie_A", "Ligue_1", "J1", "K1"],
    "guarantee_requires": [
      "kickoff > replay_coverage_start_at",
      "fixture_registered_before_cutoff",
      "latest_kickoff_revision_known_before_cutoff_or_gap_receipt",
      "required_state_fields_complete_at_cutoff"
    ]
  },
  "timing": {
    "seal_offset_minutes": 60,
    "available_at_rule": "available_at <= cutoff",
    "same_cutoff_atomic": true
  },
  "fixture_registry": {
    "identity_fields": ["fixture_id", "competition", "season"],
    "kickoff_revision_append_only": true,
    "latest_revision_defines_cutoff": true,
    "late_revision_requires_risk_or_gap_receipt": true
  },
  "state_contract": {
    "required_receipt_fields": ["fixture_id", "competition", "season", "kickoff", "cutoff", "observed_at", "source", "input_sha256", "state_sha256", "model_head", "current_sha", "capture_receipt_id"],
    "forbidden_payload_keys": ["home_goals", "away_goals", "score", "result", "winner", "outcome", "points", "xg_result", "postmatch", "final_score"]
  },
  "result_isolation": {
    "prediction_capture_must_not_read_result": true,
    "evaluator_may_read_result_only_after_prediction_receipt_sealed": true
  },
  "dedupe": {
    "reservation_completed_ledger_required": true,
    "dispatch_identity_fields": ["fixture_id", "cutoff", "model_head", "state_sha256", "input_sha256"],
    "duplicate_dispatch_suppressed": true
  },
  "failure": {
    "source_outage_or_incomplete_state": "GAP_RECEIPT",
    "retroactive_state_fabrication_forbidden": true
  },
  "formal_boundaries": {
    "formal_v2_changed": false,
    "current_changed": false,
    "production_changed": false,
    "candidate_weight": 0,
    "matrix_delta": 0
  }
}
