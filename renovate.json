{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeDisabled",
    ":approveMajorUpdates"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "commitHourlyLimit": 1,
  "packageRules": [
    {
      "description": "Require manual dashboard approval for Python runtime updates",
      "matchPackageNames": [
        "python"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Never automerge GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": false
    }
  ]
}
