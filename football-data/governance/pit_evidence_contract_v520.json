{
  "schema_version": "FOOTBALL-PIT-EVIDENCE-CONTRACT-V5.2.0",
  "status": "GOVERNANCE_CONTRACT_ONLY_NO_MODEL_PROMOTION",
  "current_authority": "unique project file named CURRENT_唯一正式规则",
  "purpose": "Define what counts as provably available pre-kickoff evidence for training, validation, and current-match inference.",
  "required_identity_fields": [
    "fixture_id",
    "competition",
    "home_team",
    "away_team",
    "scheduled_kickoff_utc",
    "kickoff_timezone_provenance",
    "source_identity"
  ],
  "required_evidence_fields": [
    "source_url_or_endpoint",
    "source_published_at_utc_if_source_native_and_verifiable",
    "collector_first_observed_at_utc",
    "retrieved_at_utc",
    "ingested_at_utc",
    "payload_sha256",
    "collector_run_id",
    "missingness_semantics"
  ],
  "provable_available_at_rule": {
    "preferred": "source_published_at_utc only when source-native, immutable/verifiable, and not retrospectively backfilled",
    "fallback": "collector_first_observed_at_utc",
    "forbidden_substitutes": [
      "dataset_build_time",
      "match_date",
      "retrospective_page_updated_at",
      "synthetic_known_at",
      "post_match_fetch_time_backdated_to_kickoff"
    ]
  },
  "eligibility": {
    "training_validation": "provable_available_at_utc < prediction_freeze_time_utc",
    "current_match": "provable_available_at_utc <= current_freeze_time_utc < scheduled_kickoff_utc",
    "unknown_time": "RETROSPECTIVE_REFERENCE_ONLY"
  },
  "market_evidence": {
    "required_for_market_dependent_models": true,
    "required_for_non_market_models": false,
    "formal_snapshot_requires": [
      "complete_prices",
      "source_identity",
      "original_quote_or_observation_timestamp",
      "freeze_window",
      "market_identity"
    ],
    "synchronization": "1X2/AH/OU constraints must come from the same admissible time window when jointly used",
    "copied_or_grouped_sources": "must not be counted as independent markets"
  },
  "lineup_injury_evidence": {
    "historical_static_without_original_prematch_time": "RETROSPECTIVE_REFERENCE_ONLY",
    "forward_capture": "eligible only when observed strictly pre-kickoff with payload hash and source identity"
  },
  "hard_boundaries": {
    "manual_backdating": false,
    "post_match_leakage": false,
    "formal_weight_change": 0,
    "current_rule_file_stored_in_repo": false
  }
}
