{
  "schema_version": "R40A-EXISTING-DATA-VARYING-ORDINAL-1.0",
  "research_only": true,
  "formal_weight": 0,
  "purpose": "Test a fully probabilistic A-D-H ordinal model whose latent match-strength location and match-specific Draw-band width are both learned only from strictly-prior same-competition data, on a seventh disjoint 100-match sample.",
  "sample": {
    "seed": "R40A_VARYING_ORDINAL_FIXED100_20260810",
    "size": 100,
    "minimum_strictly_prior_same_competition_rows": 200,
    "required_overlap_with_r39u": 0,
    "required_overlap_with_r39v": 0,
    "required_overlap_with_r39w": 0,
    "required_overlap_with_r39x": 0,
    "required_overlap_with_r39y": 0,
    "required_overlap_with_r39z": 0,
    "status": "RETROSPECTIVE_DISJOINT_PROBABILISTIC_CHALLENGER_NOT_BLIND"
  },
  "model": {
    "family": "heterogeneous-width ordered logistic A-D-H",
    "category_order": ["A", "D", "H"],
    "location_features": [
      "elo_difference_with_home_advantage",
      "home_last5_ppg_minus_away_last5_ppg",
      "home_last5_gf_minus_away_last5_gf",
      "home_last5_ga_minus_away_last5_ga",
      "home_history_ppg_minus_away_history_ppg",
      "home_history_gf_rate_minus_away_history_gf_rate",
      "home_history_ga_rate_minus_away_history_ga_rate"
    ],
    "width_features": [
      "abs_elo_difference_with_home_advantage",
      "abs_home_last5_ppg_minus_away_last5_ppg",
      "home_last5_gf_plus_away_last5_gf",
      "home_last5_ga_plus_away_last5_ga"
    ],
    "probability_form": "eta=beta*x; width=0.05+softplus(gamma0+gamma*z); theta1=center-width/2; theta2=center+width/2; P(A)=sigmoid(theta1-eta); P(D)=sigmoid(theta2-eta)-sigmoid(theta1-eta); P(H)=1-sigmoid(theta2-eta)",
    "standardization": "median/IQR fitted separately on each target's strictly-prior same-competition pool",
    "optimizer": "deterministic full-batch Adam",
    "learning_rate": 0.03,
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "adam_epsilon": 1e-8,
    "max_iterations": 300,
    "convergence_gradient_norm": 0.001,
    "convergence_objective_delta": 1e-8,
    "convergence_patience": 8,
    "location_l2": 10.0,
    "width_l2": 10.0,
    "minimum_width": 0.05,
    "manual_draw_boost": false,
    "class_weighting": false,
    "candidate_grid": false,
    "post_result_tuning": false,
    "abstention": false,
    "top1": "argmax model H/D/A probabilities with no Draw tie preference"
  },
  "baseline": {
    "name": "R39W two-stage linear Draw logistic plus conditional H/A logistic",
    "draw_l2": 10.0,
    "side_l2": 10.0,
    "same_sample": true
  },
  "frozen_gate": {
    "proper_score": "ordinal_log_loss < baseline_log_loss AND ordinal_brier <= baseline_brier",
    "draw_auc": "ordinal_draw_auc >= baseline_draw_auc",
    "draw_f1": "ordinal_draw_f1 >= 0.25 AND ordinal_draw_f1 >= baseline_draw_f1 + 0.08",
    "draw_recall": "ordinal_draw_recall >= 0.20",
    "accuracy_noninferiority": "ordinal_accuracy >= baseline_accuracy - 0.02",
    "convergence": "all 100 target fits converge under the frozen optimizer",
    "all_required": true,
    "if_pass": "Authorizes only time-ordered rolling evaluation of this exact architecture; no formal promotion.",
    "if_fail": "Stop this varying-width ordinal architecture; no post-result tuning on the seventh sample."
  },
  "hard_boundaries": {
    "external_network_requests": 0,
    "football_api_requests": 0,
    "new_data_collection": false,
    "formal_model_mutation": false,
    "formal_data_mutation": false,
    "config_mutation": false,
    "current_rule_mutation": false,
    "main_mutation": false
  }
}
