{
  "schema_version": "football3-v3-1-1-historical-replay-contract-v1",
  "project_id": "football3",
  "status": "FROZEN_BEFORE_REPLAY_DOWNLOAD_AND_SCORING",
  "research_only": true,
  "fresh_confirmation_claim": false,
  "consumption_class": "POST_VIEW_HISTORICAL_STRESS_TEST",
  "candidate": {
    "name": "V3.1.1-A Outcome-Constrained I-Projected V2 Joint Matrix",
    "head": "a90762a97515f3edd564e8ad204db0d0d4231494",
    "candidate_modification_allowed": false
  },
  "formal_v2": {
    "head": "e12f5d1193be5d81f60301cf34ab2140e11712a9",
    "weight_xg": 0.75,
    "weight_frozen_v1": 0.25,
    "must_remain_unchanged": true
  },
  "target_population": {
    "completed_only": true,
    "competitions": ["EPL", "La liga", "Bundesliga", "Serie A", "Ligue 1"],
    "season_start_years": [2024, 2025],
    "season_labels": ["2024/25", "2025/26"],
    "selection_rule": "all completed fixtures returned by the pinned public Understat league directory for each listed league-season; no result/performance filtering",
    "selection_by_result_or_performance": false,
    "expected_order_of_magnitude_n": 3504
  },
  "source": {
    "name": "Understat public AJAX JSON",
    "league_endpoint_template": "https://understat.com/getLeagueData/{league}/{season_start_year}",
    "match_endpoint_template": "https://understat.com/getMatchData/{match_id}",
    "transport_reference_repository": "https://github.com/collinb9/understatAPI",
    "transport_reference_commit": "d1252d9734e94ba98c681d2e41d467f1edb7aaf5",
    "license_classification": "SECONDARY_NONCOMMERCIAL_SUPPORT_STATEMENT_NOT_FORMAL_DATA_LICENSE",
    "use_restriction": "research-only; attribute Understat; repository must not contain raw AJAX payloads or raw shot rows"
  },
  "fixture_identity": {
    "fixture_id": "understat:{match_id}",
    "team_id": "understat-team:{team_id}",
    "competition_ids": {"EPL": 1, "Serie A": 2, "Bundesliga": 3, "La liga": 4, "Ligue 1": 5},
    "kickoff_semantics": "Understat league datetime interpreted as UTC, matching frozen historical XG research semantics",
    "duplicate_identity": "FAIL_CLOSED"
  },
  "required_download_fields": {
    "fixture": ["match_id", "kickoff", "league", "season", "home_team_id", "away_team_id", "home_team_name", "away_team_name"],
    "shot_state": ["home_xg", "away_xg", "home_npxg", "away_npxg", "home_nonpenalty_shots", "away_nonpenalty_shots", "home_npxg_per_shot", "away_npxg_per_shot", "home_open_play_share", "away_open_play_share", "home_set_piece_share", "away_set_piece_share"],
    "labels": ["home_goals", "away_goals", "outcome"]
  },
  "shot_semantics": {
    "penalty": "situation == Penalty",
    "open_play": "situation == OpenPlay",
    "set_piece": ["SetPiece", "FromCorner", "DirectFreekick"],
    "allowed_situations": ["OpenPlay", "SetPiece", "FromCorner", "DirectFreekick", "Penalty"]
  },
  "physical_separation": {
    "fixture_store": "fixtures.jsonl",
    "state_update_store": "state_updates.jsonl",
    "label_vault": "label_vault.jsonl",
    "raw_ajax_persisted": false
  },
  "replay_rules": {
    "strict_chronological_order": true,
    "same_kickoff_atomic": true,
    "release_delay_hours": 3,
    "prediction_before_current_match_update_or_label": true,
    "historical_state_warmup": "frozen Understat 2014-2023 Big-5 universe; 2024-2025 downloaded rows advance state only after each kickoff batch prediction",
    "no_tuning_after_replay_result": true
  },
  "evaluation": {
    "unique_1x2_from_15x15_matrix": true,
    "max_goals": 14,
    "metrics": ["1x2_logloss", "brier", "rps", "top1", "paired_effect", "paired_sd", "exact_score_logloss", "total_goals_calibration", "home_away_goal_marginals", "draw_conditional", "weak_win_conditional", "0-0", "1-1", "2-2", "low_score_tail", "high_score_tail", "league_season_groups", "worst_group"],
    "matrix_sum_tolerance": 1e-12,
    "matrix_to_1x2_tolerance": 1e-12,
    "formal_v2_fallback_exact": true
  },
  "forbidden": ["future_fixture_enrollment", "unplayed_fixture_scoring", "odds", "market_features", "candidate_tuning", "gate_relaxation", "CURRENT_change", "production_pointer_change", "formal_enablement_change", "formal_weight_change", "Ready", "merge", "force"]
}
