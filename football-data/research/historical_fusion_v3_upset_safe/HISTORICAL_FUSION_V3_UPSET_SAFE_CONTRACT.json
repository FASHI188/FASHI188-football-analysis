  "candidate": {
    "id": "V3-USR-1",
    "name": "Upset-Safe Favorite-vs-Draw Residual",
    "single_candidate_only": true,
    "architecture": "Identify the weaker side mechanically from formal-V2 p_home versus p_away before kickoff. Copy that weaker-side win probability exactly from formal V2. Reallocate only the remaining probability mass between the formal-V2 stronger side and draw using a regularized binary log-odds residual with formal V2 as the offset.",
    "weak_side_assignment": "home if p_home < p_away else away; exact ties fail closed to formal V2",
    "weak_probability_rule": "candidate_p_weak == formal_v2_p_weak exactly; no floor, boost, shrink or label-dependent adjustment",
    "trainable_factorization": "conditional favorite-vs-draw distribution given not-weak-win; realized weak-win rows have constant likelihood under the trainable factor and do not supply gradient",
    "prediction_equations": {
      "p_weak": "pV2_weak",
      "remaining_mass": "1-pV2_weak",
      "offset_logit": "log(pV2_favorite/pV2_draw)",
      "residual_logit": "offset_logit + beta dot standardized_features",
      "p_favorite": "remaining_mass * sigmoid(residual_logit)",
      "p_draw": "remaining_mass - p_favorite"
    },
    "features": [
      "formal_v2_abs_home_away_gap",
      "formal_v2_draw_probability",
      "formal_v2_entropy",
      "formal_v2_predicted_total_goals",
      "xg_active_flag",
      "cold_start_sparse_flag",
      "cold_start_zero_flag",
      "favorite_minus_weak_rolling_npxg_for",
      "weak_minus_favorite_rolling_npxg_against",
      "favorite_minus_weak_rolling_nonpenalty_shots_for",
      "weak_minus_favorite_rolling_nonpenalty_shots_against",
      "favorite_minus_weak_rolling_npxg_per_shot",
      "favorite_minus_weak_rolling_open_play_share",
      "favorite_minus_weak_rolling_set_piece_share"
    ],
    "excluded_features": ["finishing_residual", "keeper_residual", "realized_result", "scoreline", "post_match_xg", "odds", "market", "live_score"],
    "process_state": {"half_life_days": 90.0, "prior_matches": 12.0, "minimum_profile_weight": 3.0, "penalty_definition": "situation == Penalty", "setpiece_definitions": ["SetPiece", "FromCorner", "DirectFreekick"]},
