    "numeric_threshold": "NONE",
    "objective": "minimize KL(base || p) = sum_i base_i * log(base_i / p_i)",
    "result_feedback": false,
    "solver": "enumerate active Top1 competitor sets containing the frozen baseline Top1; solve each convex one-dimensional KKT optimum; also evaluate the weak-floor-binding KKT boundary; choose minimum reverse-KL then minimum total variation as deterministic tie-break",
