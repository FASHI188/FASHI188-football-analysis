{
  "schema_version": "EPL-LINEUP-DRAW-PREREG-R1",
  "research_scope": "lineup-confirmed 90-minute draw challenger; research only",
  "source_family": {
    "lineups": "vaastav/Fantasy-Premier-League static merged_gw.csv",
    "market": "Football-Data static E0 season CSV",
    "api_credentials": 0
  },
  "time_semantics": {
    "lineup_features": "actual starting XI; valid only after lineups are announced",
    "market_fields": "provider-defined closing semantics without row-level original quote timestamp",
    "formal_market_snapshot": false
  },
  "splits": {
    "train": "2023/24 all complete rows",
    "validation": "2024/25 all complete rows; model coverage and threshold selection only",
    "test": "2025/26 rows excluded from the complete GOLD1000 random and reserve pool"
  },
  "models": [
    {"id": "logistic", "C": 0.1, "max_iter": 3000},
    {"id": "hgb", "learning_rate": 0.05, "max_iter": 250, "max_leaf_nodes": 7, "min_samples_leaf": 15, "l2_regularization": 4.0}
  ],
  "feature_sets": {
    "market": ["fair_h", "fair_d", "fair_a", "draw_vs_side_gap", "home_away_symmetry", "overround"],
    "market_plus_lineup": [
      "fair_h", "fair_d", "fair_a", "draw_vs_side_gap", "home_away_symmetry", "overround",
      "home_starter_continuity", "away_starter_continuity", "min_starter_continuity", "continuity_gap",
      "home_starter_changes", "away_starter_changes", "total_starter_changes",
      "home_gk_changed", "away_gk_changed", "any_gk_changed",
      "home_def_changes", "away_def_changes", "total_def_changes",
      "home_mid_changes", "away_mid_changes", "total_mid_changes",
      "home_fwd_changes", "away_fwd_changes", "total_fwd_changes"
    ]
  },
  "target_coverages": [0.05, 0.10, 0.15],
  "validation_selection": {
    "primary": "maximum draw F1",
    "constraints": {"complete_1x2_accuracy_delta_min": -0.01, "selected_min": 20},
    "tie_breakers": ["higher precision", "higher recall", "lower coverage"]
  },
  "test_research_gate": {
    "paired_pr_auc_delta_min": 0.01,
    "paired_roc_auc_delta_min": 0.0,
    "draw_precision_min": 0.35,
    "draw_recall_min": 0.10,
    "draw_f1_min": 0.15,
    "complete_1x2_accuracy_delta_min": -0.01,
    "selected_min": 20
  },
  "promotion": false,
  "formal_weight": 0,
  "confirmation_reuse": "GOLD1000 confirmation A and B are excluded from this test through the full random-plus-reserve pool exclusion"
}
