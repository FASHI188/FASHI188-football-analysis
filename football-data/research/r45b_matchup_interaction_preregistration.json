{
  "schema_version": "R45B-MATCHUP-INTERACTION-PREREG-R1",
  "research_only": true,
  "formal_weight": 0,
  "target_result_labels_used": 0,
  "training_runs": 0,
  "scoring_runs": 0,
  "tuning_runs": 0,
  "manual_matchup_scores_forbidden": true,
  "purpose": "Freeze a deterministic formation/role-to-zone mapping and matchup interaction representation before any target-fixture labels are accessed.",
  "role_normalization": {
    "GK": "goalkeeper",
    "LB": "left_defensive_flank",
    "LWB": "left_defensive_flank",
    "LCB": "central_defence",
    "CB": "central_defence",
    "RCB": "central_defence",
    "RB": "right_defensive_flank",
    "RWB": "right_defensive_flank",
    "DM": "central_defensive_midfield",
    "CDM": "central_defensive_midfield",
    "6": "central_defensive_midfield",
    "LCM": "central_midfield",
    "CM": "central_midfield",
    "RCM": "central_midfield",
    "8": "central_midfield",
    "LM": "left_attacking_flank",
    "LW": "left_attacking_flank",
    "LWF": "left_attacking_flank",
    "RM": "right_attacking_flank",
    "RW": "right_attacking_flank",
    "RWF": "right_attacking_flank",
    "AM": "central_attacking_midfield",
    "CAM": "central_attacking_midfield",
    "10": "central_attacking_midfield",
    "SS": "central_attacking_midfield",
    "CF": "central_forward",
    "ST": "central_forward",
    "9": "central_forward"
  },
  "unknown_role_rule": "UNMAPPED_ROLE_FAIL_CLOSED",
  "formation_rule": "formation_or_shape is retained as source-backed context; player role_or_position_slot is normalized only through role_normalization. No formation-specific player role may be invented when the source does not provide it.",
  "fixed_zone_mapping": {
    "goalkeeper": "goalkeeper",
    "left_defensive_flank": "left_defensive_flank",
    "central_defence": "central_defence",
    "right_defensive_flank": "right_defensive_flank",
    "central_defensive_midfield": "central_defensive_midfield",
    "central_midfield": "central_midfield",
    "left_attacking_flank": "left_attacking_flank",
    "right_attacking_flank": "right_attacking_flank",
    "central_attacking_midfield": "central_attacking_midfield",
    "central_forward": "central_forward"
  },
  "interaction_pairs": [
    {"interaction_id": "HOME_LEFT_ATTACK_VS_AWAY_RIGHT_DEFENCE", "home_zone": "left_attacking_flank", "away_zone": "right_defensive_flank"},
    {"interaction_id": "HOME_RIGHT_ATTACK_VS_AWAY_LEFT_DEFENCE", "home_zone": "right_attacking_flank", "away_zone": "left_defensive_flank"},
    {"interaction_id": "HOME_CENTRAL_FORWARD_VS_AWAY_CENTRAL_DEFENCE", "home_zone": "central_forward", "away_zone": "central_defence"},
    {"interaction_id": "HOME_CENTRAL_ATTACK_VS_AWAY_DEFENSIVE_MIDFIELD", "home_zone": "central_attacking_midfield", "away_zone": "central_defensive_midfield"},
    {"interaction_id": "AWAY_LEFT_ATTACK_VS_HOME_RIGHT_DEFENCE", "home_zone": "right_defensive_flank", "away_zone": "left_attacking_flank"},
    {"interaction_id": "AWAY_RIGHT_ATTACK_VS_HOME_LEFT_DEFENCE", "home_zone": "left_defensive_flank", "away_zone": "right_attacking_flank"},
    {"interaction_id": "AWAY_CENTRAL_FORWARD_VS_HOME_CENTRAL_DEFENCE", "home_zone": "central_defence", "away_zone": "central_forward"},
    {"interaction_id": "AWAY_CENTRAL_ATTACK_VS_HOME_DEFENSIVE_MIDFIELD", "home_zone": "central_defensive_midfield", "away_zone": "central_attacking_midfield"}
  ],
  "executable_representation": {
    "algorithm": "For each source-backed XI player, map role_or_position_slot through role_normalization. If any required role is unmapped, the fixture interaction representation is unavailable. For each fixed interaction_pair, emit only the identities/counts of players occupying the two mapped zones plus source-backed formation_or_shape. Do not emit an advantage score, probability shift, goal adjustment, or manual weight.",
    "output_fields": [
      "interaction_id",
      "home_zone",
      "away_zone",
      "home_player_ids_or_names",
      "away_player_ids_or_names",
      "home_zone_player_count",
      "away_zone_player_count"
    ],
    "manual_weighting": false,
    "probability_override": false,
    "goal_adjustment": false
  },
  "ruling": "This artifact freezes representation only. It does not assert predictive value and does not authorize labels, training, scoring, tuning, OOS evaluation, or promotion."
}
