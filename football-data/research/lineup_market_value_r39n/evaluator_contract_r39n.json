{
  "schema_version": "r39n-evaluator-contract-v1",
  "frozen_before_real_target_label_evaluation": true,
  "input_mode": "two hash-locked zero-label feature snapshots",
  "binary_residual_model": {
    "newton_max_iterations": 50,
    "newton_parameter_tolerance": 1e-10,
    "sigmoid_linear_predictor_clip": [-35.0,35.0],
    "offset": "logit closing-market draw probability, coefficient fixed at 1",
    "intercept": "included and unpenalized",
    "standardization": "fit partition only; population sd below 1e-12 replaced by 1",
    "class_weights": "none",
    "threeway_mapping": "preserve closing-market H:A non-draw ratio"
  },
  "benchmarks": {
    "raw_market": true,
    "market_context": {"dimensions":2,"L2":100.0,"source":"R39N snapshot x0:x2"},
    "static_R39L": {"dimensions":10,"L2":1.0,"source":"R39M frozen snapshot s0:s10"}
  },
  "candidate": {
    "R39N_dimensions": 14,
    "L2_candidates": [1.0,10.0,100.0]
  },
  "rolling_folds": [
    {"name":"fold_2223","train_seasons":["1920","2021","2122"],"test_season":"2223"},
    {"name":"fold_2324","train_seasons":["1920","2021","2122","2223"],"test_season":"2324"}
  ],
  "candidate_selection": {
    "pooled_definition": "concatenate fold_2223 and fold_2324 test predictions from fold-specific fits",
    "order": ["lowest pooled HDA_LogLoss","lowest pooled binary_Draw_LogLoss","larger L2"]
  },
  "rolling_gate": {
    "selected_candidate_must_pass_each_fold_individually": true,
    "gate_source": "preregistration_r39n.json rolling_design.each_fold_gate",
