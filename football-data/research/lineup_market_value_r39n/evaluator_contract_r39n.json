  },
  "policy": {
    "train_seasons":["1920","2021","2122","2223","2324"],
    "test_season":"2425",
    "selected_R39N_L2_frozen_from_rolling": true,
    "benchmark_L2_values_frozen": true,
    "gate": "same as rolling individual-fold gate",
    "failure_status":"STOP_R39N_BEFORE_HOLDOUT_XI_VALUE_NO_POLICY_INCREMENT"
  },
  "blind": {
    "only_after_rolling_and_policy_pass": true,
    "refit_all_models_on_all_feature-eligible_preholdout_rows": true,
    "write_final_freeze_before_any_fixed100_label": true,
    "nonfixed_2526_labels_may_be_read": false,
    "fixed100_labels_after_freeze": 100,
    "gate": {
      "R39N_HDA_LogLoss_strictly_better_than_raw_market": true,
      "R39N_binary_Draw_LogLoss_strictly_better_than_raw_market": true,
      "R39N_HDA_Brier_nonworse_than_raw_market": true,
      "R39N_RPS_nonworse_than_raw_market": true,
      "R39N_HDA_LogLoss_strictly_better_than_market_context": true,
      "R39N_binary_Draw_LogLoss_strictly_better_than_market_context": true,
      "R39N_HDA_LogLoss_strictly_better_than_R39L_static": true,
      "R39N_binary_Draw_LogLoss_strictly_better_than_R39L_static": true,
      "R39N_Draw_AUC_strictly_better_than_R39L_static": true
    },
    "pass_status":"PASS_R39N_ACTUAL_XI_VALUE_FIXED100_EXPLORATORY_ONLY",
    "fail_status":"NO_R39N_ACTUAL_XI_VALUE_INCREMENT_FIXED100",
    "no_post_holdout_refit_or_tuning": true
  },
  "hard_limits": {"formal_weight":0,"promotion_authorized":false,"current_match_use":false,"EV":false,"formal_model_mutation":0,"formal_data_mutation":0,"config_mutation":0,"CURRENT_mutation":0,"main_mutation":0}
