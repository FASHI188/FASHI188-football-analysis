{
  "schema_version": "r39j-market-draw-regime-v1",
  "stage": "R39J_MARKET_DRAW_CALIBRATION_REGIMES",
  "research_question": "Do coarse, forward-identifiable closing-market regimes exhibit time-persistent draw calibration bias that can improve proper probability scores through a fixed shrinkage correction?",
  "source_binding": {
