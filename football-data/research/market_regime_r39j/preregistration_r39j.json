    "fixed100_date_min": "2025-08-16",
    "fixed100_date_max": "2026-05-24",
    "fixed100_labels_accessed_before_r39j_evaluation": 0
  },
  "market_transform": {
    "threeway_devig": "multiplicative inverse-odds normalization",
    "twoway_devig": "multiplicative inverse-odds normalization",
    "closing_1x2": ["AvgCH", "AvgCD", "AvgCA"],
    "closing_ou25": ["AvgC>2.5", "AvgC<2.5"],
    "closing_ah_line": "AHCh",
    "event_level_market_wrong_classifier": false,
    "top1_override_architecture": false
  },
  "chronological_design": {
    "order": "match_date_then_division_then_home_then_away",
    "fit_fraction": 0.60,
    "validation_fraction": 0.20,
    "policy_fraction": 0.20,
    "all_2526_labels_forbidden_before_final_freeze": true,
    "no_random_cross_validation": true
  },
  "regime_definition": {
    "dimensions": [
      "closing_draw_fair_probability",
      "closing_absolute_home_away_fair_probability_gap",
      "crossmarket_draw_pressure"
    ],
    "crossmarket_draw_pressure_formula": "closing_under25_fair_probability * exp(-abs(closing_home_AH_line))",
    "cutpoints": "fit-partition-only 1/3 and 2/3 empirical quantiles for each of the three dimensions",
    "bins_per_dimension": 3,
    "total_regimes": 27,
    "minimum_fit_rows_per_active_regime": 120,
    "minimum_absolute_fit_calibration_residual": 0.01,
    "minimum_absolute_fit_zscore": 1.0,
    "fit_residual": "observed_draw_rate - mean_closing_market_draw_probability within regime"
  },
  "correction": {
    "family": "regime_empirical_draw_rate_shrinkage",
    "pseudo_count": 300.0,
    "formula": "correction = n/(n+pseudo_count) * (observed_draw_rate - mean_market_draw_probability)",
    "inactive_regime_correction": 0.0,
    "event_probability": "Pdraw_corrected = clip(Pdraw_market + regime_correction, 0.02, 0.65)",
    "threeway_mapping": "preserve closing-market home:away non-draw ratio",
    "no_event_level_classifier": true,
    "no_manual_regime_sign_override": true
  },
  "validation_gate_all_required": {
    "active_regimes_min": 3,
    "corrected_HDA_LogLoss_strictly_better_than_market": true,
    "corrected_binary_Draw_LogLoss_strictly_better_than_market": true,
    "corrected_HDA_Brier_nonworse_than_market": true,
    "corrected_RPS_nonworse_than_market": true,
    "active_regime_same_sign_fraction_min": 0.60,
