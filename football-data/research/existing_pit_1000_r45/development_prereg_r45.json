{
  "schema_version": "R45-EXISTING-PIT-1000-DEVELOPMENT-PREREG-1.0",
  "status": "PREREGISTERED_DEVELOPMENT_ONLY_OOS_LOCKED",
  "formal_weight": 0,
  "research_family_status": "SEALED_INFORMATION_FAMILY_DIAGNOSTIC_REPRODUCTION_ONLY",
  "purpose": "Fit one fixed direct probabilistic H/D/A reference model on the frozen R45 train650 and evaluate only on validation150. This does not reopen the V5.2 sealed family and cannot consume locked_oos200.",
  "sample_receipt": "football-data/research/existing_pit_1000_r45/sample_freeze_receipt_r45.json",
  "partitions": {
    "train": 650,
    "validation": 150,
    "locked_oos": 200,
    "locked_oos_labels_allowed": false
  },
  "target": {
    "column": "label_result",
    "classes": ["H", "D", "A"],
    "read_scope": ["train650", "validation150"]
  },
  "features": [
    "home_history_matches",
    "home_history_gf",
    "home_history_ga",
    "home_history_ppg",
    "home_venue_matches",
    "home_venue_gf",
    "home_venue_ga",
    "home_last5_matches",
    "home_last5_gf",
    "home_last5_ga",
    "home_last5_ppg",
    "away_history_matches",
    "away_history_gf",
    "away_history_ga",
    "away_history_ppg",
    "away_venue_matches",
    "away_venue_gf",
    "away_venue_ga",
    "away_last5_matches",
    "away_last5_gf",
    "away_last5_ga",
    "away_last5_ppg",
    "home_elo_pre_match",
    "away_elo_pre_match",
    "elo_difference_with_home_advantage",
    "cold_start_flag",
    "stage_unverified_flag"
  ],
  "preprocessing": {
    "numeric_cast": "float",
    "missing_policy": "STOP_IF_ANY_MISSING_ON_TRAIN_OR_VALIDATION",
    "standardization": "train650_mean_and_population_sd_only",
    "zero_sd_policy": "use_scale_1"
  },
  "model": {
    "type": "multinomial_logistic_regression_softmax",
    "implementation": "stdlib_full_batch_gradient_descent",
    "initialization": "all_zero_weights_and_intercepts",
    "l2_lambda": 0.1,
    "regularize_intercept": false,
    "learning_rate": 0.05,
    "iterations": 1200,
    "hyperparameter_search": false
  },
  "baseline": {
    "type": "train650_empirical_class_prior",
    "smoothing": 0
  },
  "validation_metrics": [
    "multiclass_log_loss",
    "multiclass_brier",
    "rps_H_D_A",
    "top_confidence_ece_10bin",
    "draw_average_precision",
    "draw_brier",
    "draw_mean_probability",
    "draw_prevalence",
    "draw_precision_argmax",
    "draw_recall_argmax",
    "draw_f1_argmax",
    "accuracy_secondary_only",
    "prediction_counts"
  ],
  "oos_gate": {
    "locked_oos200_labels_read": false,
    "automatic_release_after_validation": false,
    "reason": "V5.2 research-family registry seals ordinary recent-form/Elo/static same-information variants and forbids spending a new fixed sample on minor same-family transformations."
  },
  "boundaries": {
    "new_match_downloads": 0,
    "external_network_requests": 0,
    "formal_model_mutation": false,
    "formal_data_mutation": false,
    "current_rule_mutation": false,
    "main_mutation": false
  }
}
