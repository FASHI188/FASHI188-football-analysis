{
  "schema_version": "R45-EXISTING-PIT-1000-PREREG-1.1",
  "status": "PREREGISTERED_ZERO_LABEL_ONLY",
  "purpose": "Build one new research-only 1000-match strictly chronological experiment from existing downloaded PIT datasets without using any historical protected sample.",
  "formal_weight": 0,
  "source": {
    "glob": "football-data/training_datasets/*/point_in_time.csv",
    "expected_file_count": 17,
    "new_downloads_allowed": false,
    "external_network_allowed": false
  },
  "identity_fields": ["competition_id", "season", "date", "home_team", "away_team"],
  "selection": {
    "target_rows": 1000,
    "selection_must_be_label_blind": true,
    "candidate_split": "train",
    "chronological_protection_wall_exclusive": "2023-01-27",
    "selection_rule": "From eligible rows strictly before the protection wall, after exact current-repository protected-identity exclusion, sort by date/competition/season/home/away and take the latest 1000 rows.",
    "sort": ["date", "competition_id", "season", "home_team", "away_team"],
    "explicitly_excluded_seasons": ["2025/26"],
    "repository_protected_name_terms": ["fixed", "gold", "reserve", "holdout", "blind", "oos", "protected"],
    "full500_policy": "PROTECTED_EXCLUDE; verified v6490/v6493 are 2025/26 historical research samples",
    "gold1000_policy": "PROTECTED_EXCLUDE; verified GOLD1000-R1 random1000 plus reserve2000; earliest protected identity 2023-01-27",
    "2025_observable_policy": "PROTECTED_HOLDOUT_EXCLUDE; resolved to R39O holdout_2526",
    "freeze_only_if": [
      "selected_count_equals_1000",
      "selected_max_date_is_strictly_before_2023_01_27",
      "selected_overlap_with_current_repo_structured_protected_identities_equals_0",
      "protected_assets_receipt_is_present_and_consistent",
      "zero_target_label_values_referenced",
      "zero_model_fits_and_zero_candidate_probabilities"
    ]
  },
  "frozen_split_if_preflight_passes": {
    "train": 650,
    "validation": 150,
    "locked_oos": 200,
    "method": "chronological_no_random_split",
    "order": "first650_train_next150_validation_last200_locked_oos"
  },
  "phase_1_hard_boundaries": {
    "label_values_read": 0,
    "model_fits": 0,
    "candidate_probabilities": 0,
    "oos_labels_read": 0,
    "formal_model_mutation": false,
    "formal_data_mutation": false,
    "current_rule_mutation": false,
    "main_mutation": false
  },
  "planned_metrics_after_model_freeze": [
    "multiclass_log_loss",
    "multiclass_brier",
    "rps",
    "calibration",
    "draw_pr_auc",
    "draw_precision",
    "draw_recall",
    "draw_f1",
    "accuracy_secondary_only"
  ]
}
