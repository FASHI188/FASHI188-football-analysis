{
  "schema_version": "R45-EXISTING-PIT-1000-PREREG-1.0",
  "status": "PREREGISTERED_ZERO_LABEL_ONLY",
  "purpose": "Build a new research-only 1000-match chronological experiment from existing downloaded PIT datasets without using protected historical samples.",
  "formal_weight": 0,
  "source": {
    "glob": "football-data/training_datasets/*/point_in_time.csv",
    "new_downloads_allowed": false,
    "external_network_allowed": false
  },
  "identity_fields": ["competition_id", "season", "date", "home_team", "away_team"],
  "selection": {
    "target_rows": 1000,
    "selection_must_be_label_blind": true,
    "sort": ["date", "competition_id", "season", "home_team", "away_team"],
    "candidate_split": "train",
    "explicitly_excluded_seasons": ["2025/26"],
    "protected_name_terms": ["fixed", "gold", "reserve", "holdout", "blind", "oos", "protected"],
    "full500_policy": "UNRESOLVED_FAIL_CLOSED_UNTIL_IDENTIFIED",
    "gold1000_reserve500_policy": "PROTECTED_EXCLUDE",
    "2025_observable_policy": "TREAT_AS_R39O_HOLDOUT_2025_26_EXCLUDE",
    "freeze_only_if_exact_protected_overlap_is_zero": true
  },
  "planned_split_after_freeze": {
    "train": 650,
    "validation": 150,
    "locked_oos": 200,
    "method": "chronological_no_random_split"
  },
  "phase_1_hard_boundaries": {
    "label_values_read": 0,
    "model_fits": 0,
    "candidate_probabilities": 0,
    "oos_labels_read": 0,
    "formal_model_mutation": false,
    "formal_data_mutation": false,
    "current_rule_mutation": false,
    "main_mutation": false
  },
  "planned_metrics_after_model_freeze": [
    "multiclass_log_loss",
    "multiclass_brier",
    "rps",
    "calibration",
    "draw_pr_auc",
    "draw_precision",
    "draw_recall",
    "draw_f1",
    "accuracy_secondary_only"
  ]
}
