,"baseline_parameter_selection":"target competition only; selected from strictly earlier outer seasons using frozen nested_backtest_v460 logic","baseline_calibration":"target-season calibrator uses only earlier outer-season OOF records and frozen guardrails; target-season outcomes excluded","within_target_season_candidate_refit":false,"all_target_rows":"evaluation only","fold_without_required_prior_history":"EXCLUDE_AND_REPORT"},"common_cohort":{"core_candidates":"B0,A1-A6,C1-C5 and C5-minus-family ablations use exactly the same rows per fold","required_per_row":["valid H/D/A label","exact OOF baseline H/D/A probabilities","exact OOF score matrix","all S1-S6 source fields either observed or handled by frozen missing policy"],"baseline_unsupported_row":"exclude from every core candidate in that fold","secondary_shot_cohort":"X1 uses the intersection of core rows and complete lagged-shot features; B0 and C5 are recomputed on that identical subset","kor_round_cohort":"X2 uses KOR core rows with verified round mapping; B0 and C5 are recomputed on identical KOR rows","minimum_rows_per_outer_fold":100,"minimum_outer_folds_per_competition":2,"competition_below_minimum":"not eligible for support gate; still listed with exclusion reason"},"feature_generation":{"global_rules":{"source_match_condition":"source competition matches with source_date < target_date only","current_target_row_in_history":false,"same_day_result_in_history":false,"numeric_imputation":"outer-training-pool median","missing_indicators":"one binary indicator for every numeric feature with any missing value in training or evaluation","numeric_standardization":"outer-training-pool mean and population standard deviation after imputation","near_zero_variance":"drop when training std < 1e-12 and record the drop","categorical_encoding":"outer-training-pool one-hot with reserved __UNKNOWN__","winsorization":"none except explicit clamps below","exact_duplicate_rule":"symbolically identical formulas or identical source/value vectors are collapsed before fitting","empirical_duplicate_rule":"if max absolute difference after canonical scaling <=1e-12 or |Pearson r|>=0.999999, keep earlier family priority S1,S3,S4,S2,S5,S6 and report removal","label_based_feature_selection":false},"S1_STRENGTH_CLOSENESS":{"baseline_balance":"1 - abs(pH_oof - pA_oof)","abs_elo_gap":"abs(home_elo_pre_match - away_elo_pre_match)","abs_elo_home_adv_gap":"abs(elo_difference_with_home_advantage)"},"S2_RECENT_FORM_ATTACK_DEFENCE":{"last5_ppg_gap":"abs(home_last5_ppg - away_last5_ppg)","last5_gf_gap":"abs(home_last5_gf - away_last5_gf)","last5_ga_gap":"abs(home_last5_ga - away_last5_ga)","gd10_gap":"abs(mean(last up to 10 home-team goal differences) - mean(last up to 10 away-team goal differences))","venue_ppg5_gap":"abs(mean points in home team's last up to 5 prior home matches - mean points in away team's last up to 5 prior away matches)","rest_diff_days":"clamp(days_since_home_last_match - days_since_away_last_match,-30,30)","minimum_history":"zero prior matches produces missing numeric value plus missing indicator; no synthetic result"},"S3_HISTORICAL_DRAW_PROPENSITY":{"outer_training_prior":"mu_draw=(training_draws+1)/(training_matches+2)","shrinkage_matches":8.0,"league_draw_rate_prior":"current-season draws before target date shrunk to mu_draw with 16 pseudo-observations","home_venue_draw_rate_shrunk_prior":"(home_prior_venue_draws + 8*league_draw_rate_prior)/(home_prior_venue_matches+8)","away_venue_draw_rate_shrunk_prior":"(away_prior_venue_draws + 8*league_draw_rate_prior)/(away_prior_venue_matches+8)","pair_draw_residual":"0.5*(home_venue_draw_rate_shrunk_prior+away_venue_draw_rate_shrunk_prior)-league_draw_rate_prior"},"S4_LOW_GOAL_ENVIRONMENT":{"lagged_expected_total_proxy":"0.5*(home_last5_gf + away_last5_ga) + 0.5*(away_last5_gf + home_last5_ga)","low_goal_index":"clamp(2.5-lagged_expected_total_proxy,-3,3)","oof_expected_total":"sum((home_goals+away_goals)*cell_probability) over exact OOF