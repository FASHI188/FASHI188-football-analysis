  "objective": {
    "primary": "retain the frozen V3.2.3 T2 parity Top1 direction only when that direction is invariant to deleting any one complete earlier training season, then cross the frozen V3.1.1 Top1 boundary with the deterministic minimum-L2 projection and weak-side floor",
    "comparative_baseline": "FROZEN_V3_1_1_JOINT_SCORE",
    "stage4_problem": "direction signal exists but probability/proper-score stability is not transportable across time folds",
    "no_abstention": true,
    "long_run_target_top1_accuracy": 0.55,
    "target_is_not_a_guarantee": true
  },
  "frozen_direction_generator": {
    "family": "T2",
    "params": {
      "cap": 0.02,
      "draw_lambda": 16.0,
      "draw_scale": 0.25,
      "half_life": 1.0,
      "side_lambda": 4.0,
      "side_scale": 0.25,
      "support_tau": 1.5
    },
    "source": "EXACT_V3_2_3_T2_SELECTED_DIRECTION_ONLY",
    "no_parameter_selection_in_stage4": true
  },
  "reliability_gate": {
    "name": "UNANIMOUS_LEAVE_ONE_TRAINING_SEASON_OUT_DIRECTION_CONSENSUS",
    "full_fit_training_rows": "all eligible rows with 2018 <= season < target_season",
    "jackknife_units": "each distinct complete training season is deleted once",
    "minimum_distinct_training_seasons": 2,
    "decision_rule": "for an otherwise eligible full-fit T2 proposal whose argmax differs from frozen V3.1.1, execute only if every leave-one-training-season-out refit remains eligible and has the identical target argmax as the full fit; otherwise use exact frozen V3.1.1",
    "same_target_required_for_all_jackknives": true,
    "numeric_threshold": "NONE",
    "threshold_grid": "NONE",
    "horizon_grid": "NONE",
    "result_feedback": false,
    "fold_id_input": false,
    "team_or_league_exception": false,
    "market_input": false,
    "target_outcome_input": false,
    "manual_exception": false
  },
  "projection": {
    "name": "DETERMINISTIC_MINIMUM_L2_TOP1_BOUNDARY_PROJECTION",
    "epsilon": 1e-09,
    "rule": "keep nonbinding outcomes unchanged when possible; equalize the target and all probability competitors that would otherwise remain above it, then give the target epsilon lead while conserving total probability",
    "weak_side_floor": "P_weak_after >= P_weak_before per fixture; if infeasible, fall back exactly to frozen V3.1.1",
    "new_learned_gate": "NONE",
    "new_threshold_grid": "NONE"
  },
  "pit_contract": {
    "cutoff": "fixture_kickoff",
    "lagged_completed_match_information_only": true,
    "all_jackknife_refits_use_strictly_earlier_seasons": true,
    "same_kickoff_cross_fixture_leakage": false,
    "target_postmatch_or_live_information": "FORBIDDEN",
