    "raw_probability": "(sum_lag decay^lag * I(started_prior_match) + smoothing) / (sum_lag decay^lag + 2*smoothing)",
    "projection": "shared logit shift across candidate probabilities so projected P(start) sums to 11",
    "expected_xi": "top 11 projected P(start); ties by cumulative prior minutes then player_id",
    "no_parameter_search": true,
    "no_training_or_refit": true,
    "no_injury_backfill": true,
    "no_current_target_lineup_feature": true,
    "same_date_matches_are_not_prior": true
  },
  "comparators": {
