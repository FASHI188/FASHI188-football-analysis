  "scientific_hypothesis": {
    "id": "STRICT_PREMATCH_TEAM_ROLE_LOW_SCORE_LOG_ODDS_ASSOCIATION",
    "statement": "The frozen competition-level low-score residual factors do not capture team-role-specific diagonal versus off-diagonal dependence. Strictly earlier home-role and away-role score histories can provide a pre-match low-score association signal concentrated in 0-0,1-0,0-1,1-1 without changing the high-score generator.",
    "independent_of_dynamic_share_failure": true,
    "no_kappa_rescue": true,
    "no_top4_or_22_protection": true
  },
  "association_state": {
    "source_table": "general_game_stats",
    "low_score_cells": [[0,0],[1,0],[0,1],[1,1]],
    "chronology": "ONLY source matches with kickoff strictly earlier than target kickoff; same-kickoff excluded",
    "target_sources": [
      "target_home_team_prior_home_matches in native home-away score orientation",
      "target_away_team_prior_away_matches in native home-away score orientation"
    ],
    "per_source_signal": "Haldane-Anscombe/Jeffreys-smoothed odds ratio OR=((n00+0.5)*(n11+0.5))/((n10+0.5)*(n01+0.5))",
    "source_eligibility": "team-role source is used iff it has at least one observed low-score cell among the four; otherwise fallback",
    "fallback_hierarchy": ["team_role", "same_league_low_score_pool", "big5_low_score_pool"],
    "source_combination": "equal arithmetic mean of the two resolved log(OR) values; desired_OR=exp(mean_log_OR)",
    "pseudocount_per_cell": 0.5,
    "trainable_parameters": "NONE",
    "label_fitted_parameters_on_target_period": "NONE",
    "threshold_grid": "NONE",
    "market_inputs": "FORBIDDEN",
    "future_or_same_kickoff_rows": "FORBIDDEN"
  },
  "local_reference_tilt": {
    "base_matrix": "frozen V3.1.1 score matrix",
    "base_low_score_OR": "(p00*p11)/(p10*p01)",
    "delta": "0.25*(log(desired_OR)-log(base_low_score_OR))",
    "multipliers": {
      "0-0": "exp(+delta)",
      "1-1": "exp(+delta)",
      "1-0": "exp(-delta)",
      "0-1": "exp(-delta)",
      "all_other_cells": 1.0
    },
    "normalization": "single full-matrix normalization before constraint projection",
    "no_cell_specific_selection": true,
    "no_high_score_change_in_reference": true
  },
  "constraint_projection": {
    "id": "TOTAL_PLUS_HDA_KL_IPROJECTION",
    "purpose": "constraint enforcement only",
    "reference": "locally tilted frozen V3.1.1 matrix",
    "constraints": [
      "preserve every frozen V3.1.1 total-goals marginal exactly",
      "preserve frozen V3.2.4 target H/D/A probabilities exactly"
    ],
    "algorithm": "deterministic iterative proportional fitting alternating total-goal slices and H/D/A partitions",
    "tolerance": 1e-13,
    "max_iterations": 10000,
    "no_tuning": true
  },
  "application_scope": {
    "all_target_matches": true,
    "non_switch_matches": "H/D/A remains frozen V3.1.1 while low-score reference dependence may change",
    "v3_2_4_switch_matches": "H/D/A equals frozen V3.2.4 target while the same pre-match local dependence rule is used"
  },
