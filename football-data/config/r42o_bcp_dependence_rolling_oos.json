{
  "schema_version": "r42o_bcp_dependence_rolling_oos.1",
  "base_model_config": "config/v510_historical_label_structure_rolling_r1.json",
  "input_ledger": "manifests/v510_existing_score_market_pit_ledger_r1_rows.csv",
  "research_source": {
    "paper": "A Bayesian bivariate Conditional Poisson regression for goal dependence in the English Premier League",
    "arxiv": "2608.07168",
    "submitted": "2026-08-07",
    "adaptation": "frequentist dependence-only BCP challenge; not an exact Bayesian/HMC reproduction"
  },
  "split_contract": {
    "rolling_test_positions_zero_based": [2, 3, 4],
    "direction_selected_on_policy_only": true,
    "test_labels_used_for_direction_selection": false,
    "test_labels_used_for_parameter_selection": false,
    "same_day_strict_prior_features": true
  },
  "marginal_rate_contract": {
    "features": "current V5.1 strict-prior 47-feature core",
    "model": "PoissonRegressor",
    "alpha": 1.0,
    "max_iter": 700,
    "tol": 1e-7,
    "fit_intercept": true,
    "prediction_rate_clip": [1e-8, 20.0],
    "same_marginal_rates_for_baseline_and_challenger": true,
    "market_features": false,
    "web_features": false
  },
  "bcp_contract": {
    "baseline_phi": 0.0,
    "challenger_phi_fitted": true,
    "phi_bounds": [-0.5, 0.5],
    "phi_optimizer": "scipy_minimize_scalar_bounded",
    "phi_xatol": 1e-8,
    "directions": ["H_TO_A", "A_TO_H"],
    "direction_policy_metric": "joint_score_logloss",
    "final_phi_refit_on_train_plus_policy": true,
    "joint_grid_max_goals_each_team": 25,
    "max_probability_mass_residual": 1e-8,
    "phi_boundary_not_hit_required": true,
    "manual_draw_bonus": false,
    "manual_score_adjustment": false,
    "manual_total_adjustment": false
  },
  "bootstrap": {
    "samples": 5000,
    "seed": 42301,
    "interval": [0.05, 0.95],
    "unit": "competition_season_block"
  },
  "decision_contract": {
    "primary_metric": "pooled_rolling_oos_joint_score_logloss",
    "pass_requires_joint_score_logloss_p95_below_zero": true,
    "minimum_folds_with_better_joint_score_logloss": 2,
    "hda_logloss_nonworse_required": true,
    "hda_brier_nonworse_required": true,
    "hda_rps_nonworse_required": true,
    "direct_total_logloss_nonworse_required": true,
    "direct_total_brier_nonworse_required": true,
    "draw_binary_logloss_nonworse_required": true,
    "probability_mass_audit_required": true,
    "optimizer_convergence_required": true,
    "phi_boundary_not_hit_required": true,
    "pass_authorizes_only_fresh_fixed200_challenge": true,
    "pass_does_not_promote_formal_model": true
  },
  "governance": {
    "research_only": true,
    "challenge_model": true,
    "formal_weight": 0,
    "retrospective_viewed_evidence": true,
    "protected_blind_access": 0,
    "fixed200_consumed": 0,
    "provider_requests": 0,
    "new_data_collection": false,
    "market_features_allowed": false,
    "web_context_features_allowed": false,
    "current_match_use": false,
    "formal_model_mutation": false,
    "formal_data_mutation": false,
    "formal_config_mutation": false,
    "current_mutation": false,
    "main_mutation": false
  }
}
