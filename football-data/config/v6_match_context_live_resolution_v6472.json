{
  "schema_version": "V6.47.2-match-context-live-resolution-contract-r1",
  "formal_current_version": "V5.0.1",
  "classification": "RESEARCH_INPUT_GOVERNANCE_NO_PROBABILITY_MUTATION",
  "purpose": "Separate static team-cache coverage from exact-match pre-freeze context and prevent stale global completeness counters from blocking a match.",
  "static_cache": {
    "authoritative_roster_manifest": "manifests/v6_current_roster_overlay_v669_status.json",
    "authoritative_gap_manifest": "manifests/v6_roster_gap_inventory_v6611_status.json",
    "accepted_current_roster_semantics": ["CURRENT_FIRST_TEAM", "CURRENT_REGISTERED_SQUAD"],
    "cache_only": true,
    "may_not_imply_match_availability": true,
    "may_not_imply_predicted_xi": true
  },
  "match_bound_authority": {
    "ledger": "manifests/v6_match_context_pit_v6310_status.json",
    "required_identity": ["match_id", "competition_id", "home_team", "away_team", "kickoff_at_utc", "freeze_at_utc"],
    "required_live_axes": ["head_coach", "availability", "suspensions", "predicted_xi", "material_roster_delta_since_cache"],
    "evidence_must_be_observed_at_or_before_freeze": true,
    "evidence_must_be_before_kickoff": true,
    "actual_lineup_may_not_backfill_predicted_xi": true,
    "explicit_no_absences_required_for_verified_empty": true,
    "minimum_predicted_xi_named_players": 11
  },
  "live_resolution": {
    "trigger_when": [
      "static_roster_missing",
      "static_roster_stale",
      "manager_missing_or_stale",
      "availability_missing_or_stale",
      "predicted_xi_missing_or_stale",
      "material_transfer_or_manager_change_after_weekly_snapshot"
    ],
    "source_priority": [
      "official_club",
      "official_league_or_federation",
      "official_competition",
      "independent_structured_source"
    ],
    "cross_source_player_union_forbidden": true,
    "unverified_absence_inference_forbidden": true,
    "post_freeze_source_forbidden": true,
    "post_kickoff_source_forbidden": true
  },
  "runtime_status_policy": {
    "PIT_READY": "All required match-bound axes supported by valid pre-freeze evidence.",
    "PARTIAL_PIT": "At least one dynamic axis is missing, but available axes remain usable individually.",
    "LIVE_RESOLUTION_REQUIRED": "The static cache is insufficient and a current pre-freeze lookup must be attempted before grading the match context.",
    "DEGRADED": "A required dynamic axis remains unverifiable after live lookup; do not invent it.",
    "ABSTAIN_CONTEXT_FEATURE": "The unverifiable context feature receives no research contribution. This does not invalidate an independently identified market-only track."
  },
  "hard_guards": {
    "weekly_global_completeness_may_not_block_market_only_track": true,
    "legacy_full_context_counter_may_not_satisfy_match_pit_gate": true,
    "missing_dynamic_context_never_means_no_change": true,
    "missing_dynamic_context_never_means_no_injury": true,
    "research_context_weight_requires_separate_oos_promotion": true,
    "formal_probability_change": false,
    "formal_weight_change": false,
    "current_rule_change": false
  }
}
