{
  "schema_version": "V6.31.1-match-team-context-contract-r2",
  "status": "REGISTERED_RESEARCH_ONLY",
  "purpose": "Bind pre-match roster/manager/availability/predicted-XI evidence to the same frozen match_id used by the prospective market ledger, without allowing post-kickoff backfill or duplicating full roster payloads in every fixture event.",
  "required_event_type": "MATCH_TEAM_CONTEXT_FROZEN",
  "required_fixture_fields": ["competition_id", "season", "kickoff_at", "home_team", "away_team", "settlement_scope"],
  "team_context_axes": {
    "roster": {
      "allowed_status": ["STRICT_CURRENT", "PROVISIONAL_CONTINUITY_ONLY", "UNAVAILABLE"],
      "minimum_named_players_for_strict": 18,
      "strict_evidence_forms": [
        "inline players list >=18 plus timestamped sources",
        "player_count >=18 plus immutable repository snapshot_file + snapshot_sha256 plus timestamped sources"
      ],
      "duplicate_full_roster_in_every_match_event": false
    },
    "manager": {"allowed_status": ["VERIFIED", "UNAVAILABLE"]},
    "availability": {
      "allowed_status": ["PIT_VERIFIED_NONEMPTY", "PIT_VERIFIED_EMPTY", "UNKNOWN"],
      "empty_is_verified_only_with_dedicated_timestamped_source": true
    },
    "predicted_xi": {
      "allowed_status": ["PIT_PREDICTED_XI", "DEPTH_CONTEXT_ONLY", "UNAVAILABLE"],
      "minimum_players_for_predicted_xi": 11,
      "actual_lineup_after_freeze_may_not_backfill": true
    }
  },
  "source_contract": {
    "required": ["source_name", "source_url", "source_observed_at_utc", "source_role"],
    "source_observed_at_must_not_exceed_freeze_at": true,
    "source_observed_at_must_precede_kickoff": true,
    "official_or_structured_source_preferred": true,
    "systematic_scraping_that_conflicts_with_source_terms_prohibited": true,
    "manual_question_time_web_evidence_allowed_when_source_is_publicly_viewable": true
  },
  "event_contract": {
    "append_only_hash_chain": true,
    "freeze_at_must_precede_kickoff": true,
    "one_latest_valid_context_event_per_match_id": true,
    "later_pre_kickoff_refresh_allowed_as_new_event": true,
    "post_kickoff_context_refresh_prohibited": true,
    "market_match_id_binding_required": true,
    "repository_snapshot_reference_must_be_sha256_bound": true
  },
  "model_use": {
    "current_status": "INPUT_COLLECTION_ONLY",
    "formal_weight": 0,
    "probability_mutation": false,
    "future_promotion_requires_forward_settled_sample": true,
    "feature_effects_must_be_trained_only_from_prior_frozen_context_events": true
  },
  "governance": {
    "formal_current_version": "V5.0.1",
    "current_rule_change": false,
    "automatic_promotion": false
  }
}
