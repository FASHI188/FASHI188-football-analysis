{
  "schema_version": "r43a_betfair_basic_pit_coverage.1",
  "purpose": "zero-label coverage audit for synchronized pre-match Betfair Exchange market-shape data",
  "source_contract": {
    "provider": "Betfair Historical Data",
    "plan": "BASIC",
    "sport": "Soccer",
    "event_type_id": "1",
    "input_roots": [
      "football-data/external/betfair-basic",
      "external/betfair-basic"
    ],
    "accepted_extensions": [".bz2", ".json", ".jsonl"],
    "event_files_preferred": true,
    "result_or_settlement_fields_used": false,
    "post_kickoff_messages_used": false
  },
  "market_contract": {
    "match_odds_market_type": "MATCH_ODDS",
    "asian_handicap_market_type_contains": "ASIAN_HANDICAP",
    "over_under_market_type_prefix": "OVER_UNDER_",
    "recognized_over_under_lines": [0.5, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5],
    "minimum_complete_ou_lines": 4,
    "required_anchor_ou_line": 2.5,
    "require_ou_below_anchor": true,
    "require_ou_above_anchor": true,
    "match_odds_required_complete_runners": 3,
    "asian_handicap_minimum_complete_runners": 2,
    "over_under_required_complete_runners": 2,
    "price_field": "lastPriceTraded/ltp",
    "strict_positive_decimal_price": true
  },
  "freeze_contract": [
    {"id": "T24H", "minutes_before_kickoff": 1440, "max_quote_age_minutes": 360},
    {"id": "T6H", "minutes_before_kickoff": 360, "max_quote_age_minutes": 180},
    {"id": "T1H", "minutes_before_kickoff": 60, "max_quote_age_minutes": 60}
  ],
  "coverage_gate": {
    "minimum_events_all_freezes_complete": 200,
    "minimum_distinct_countries": 3,
    "minimum_distinct_calendar_months": 6,
    "require_all_three_freezes": true,
    "labels_used_for_gate": false,
    "market_prices_used_for_gate": false,
    "gate_uses_metadata_and_quote_availability_only": true
  },
  "future_experiment_boundary": {
    "fixed200_not_selected_until_coverage_passes": true,
    "future_fixed200_must_exclude_all_previously_consumed_fixed200": true,
    "future_model_or_threshold_fit_during_coverage_audit": false,
    "future_target": "multi-line OU curve -> direct P(T=0..7+); AH+Match Odds -> conditional margin support"
  },
  "governance": {
    "research_only": true,
    "formal_weight": 0,
    "zero_label": true,
    "model_fit": 0,
    "provider_requests_from_actions": 0,
    "protected_blind_access": 0,
    "formal_model_mutation": false,
    "formal_data_mutation": false,
    "formal_config_mutation": false,
    "current_mutation": false,
    "main_mutation": false
  }
}
