{
  "schema_version": "V5.1.0-strict-pit-settlement-r16",
  "classification": "RESEARCH_ONLY_FORWARD_SETTLEMENT_LINK_CONTRACT",
  "formal_weight": 0,
  "capture_ledger": "football-data/forward/inbox/v510_strict_pit_capture_r14.json",
  "result_inbox": "football-data/forward/inbox/market_first_results_v651.json",
  "identity_contract": {
    "required_fields": [
      "competition_id",
      "kickoff_at",
      "home_team",
      "away_team",
      "home_goals_90",
      "away_goals_90",
      "actual_result",
      "settlement_scope",
      "source",
      "prediction_event_hash"
    ],
    "prediction_event_hash_must_match_capture_event_sha256": true,
    "fixture_identity_must_match_capture": true,
    "duplicate_settlement_per_capture_allowed": false,
    "conflicting_score_records_allowed": false
  },
  "settlement_contract": {
    "accepted_settlement_scopes": [
      "90_minutes_including_stoppage",
      "90m_including_stoppage_excluding_extra_time_penalties_qualification"
    ],
    "minimum_minutes_after_kickoff_before_result_observation": 90,
    "source_required_fields": [
      "name",
      "url",
      "observed_at",
      "source_record_id"
    ],
    "source_url_required": true,
    "source_observed_at_must_follow_kickoff": true,
    "nonnegative_integer_score_required": true,
    "actual_result_must_equal_score_direction": true,
    "zero_zero_counts_as_draw": true
  },
  "readiness_gate": {
    "minimum_settled_strict_pit_rows": 60,
    "minimum_settled_draws": 15,
    "minimum_settled_zero_zero": 3,
    "minimum_rows_with_complete_three_market_capture": 60,
    "minimum_rows_with_both_team_context": 30,
    "capture_failures_allowed": 0,
    "identity_conflicts_allowed": 0,
    "settlement_conflicts_allowed": 0,
    "unmatched_duplicate_results_allowed": 0
  },
  "hard_limits": {
    "no_result_backfill_into_capture_event": true,
    "no_retroactive_capture_timestamp_change": true,
    "no_model_fit_in_settlement_audit": true,
    "no_probability_mutation": true,
    "no_current_match_probability": true,
    "no_exact_score_output": true,
    "no_ev_output": true,
    "no_provider_request_in_ci": true,
    "no_current_or_main_mutation": true
  }
}
