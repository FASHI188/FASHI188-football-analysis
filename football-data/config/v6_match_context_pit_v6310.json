    "post_freeze_injury_news_may_not_backfill_availability": true,
    "empty_availability_without_explicit_source_statement_is_unknown": true,
    "roster_or_depth_chart_may_not_substitute_for_predicted_xi": true,
    "match_id_must_exist_in_prospective_market_ledger": true,
    "formal_weight_change": false,
    "runtime_probability_change": false,
    "current_rule_change": false
  },
  "governance": {
