{
  "schema_version": "V6.31.0-match-context-pit-config-r1",
  "status": "REGISTERED_RESEARCH_ONLY",
  "purpose": "Bind timestamped pre-kickoff availability and predicted-XI evidence to an existing prospective market match_id without mutating formal probabilities.",
  "forward_ledger": "football-data/forward/v6_market_first_events_v651.json",
  "evidence_directory": "football-data/evidence/match_context_pre_kickoff",
  "availability_source_role_tokens": [
    "injury",
    "availability",
    "suspension",
    "fitness",
    "team news"
  ],
  "predicted_xi_source_role_tokens": [
    "predicted xi",
    "expected xi",
    "projected xi",
    "probable xi",
    "predicted lineup",
    "expected lineup",
    "projected lineup",
    "probable lineup"
  ],
  "minimum_predicted_xi_players": 11,
  "evidence_document_contract": {
    "required_top_level": ["schema_version", "match_id", "fixture_identity", "observed_at_utc", "sources"],
    "fixture_identity": ["competition_id", "home_team", "away_team", "kickoff_at"],
    "source_required": ["team_name", "source_role", "source_name", "source_url", "source_tier", "source_observed_at_utc"],
