{
  "schema_version": "r41a_fixed200_joint_error_decomposition.1",
  "base_model_config": "config/v510_historical_label_structure_rolling_r1.json",
  "input_ledger": "manifests/v510_existing_score_market_pit_ledger_r1_rows.csv",
  "sample_contract": {
    "sample_size": 200,
    "seed": 41101,
    "target_season": "latest_complete_season_per_competition",
    "selection": "global_sha256_rank_over_identity_from_target_pool",
    "identity_fields": ["competition_id", "season", "date_key", "home_team", "away_team"],
    "labels_used_for_selection": false,
    "retrospective_viewed_sample": true,
    "blind_claim": false
  },
  "fit_contract": {
    "train_season_positions_zero_based": [0, 1, 2],
    "policy_season_position_zero_based": 3,
    "test_season_position_zero_based": 4,
    "C_selection_uses_fixed200": false,
    "same_day_feature_freeze_before_update": true
  },
  "bootstrap": {
    "samples": 5000,
    "seed": 41102,
    "interval": [0.05, 0.95]
  },
  "decision_contract": {
    "primary_verdict_uses_non_tail_rows": true,
    "total_component_dominant_if_bootstrap_difference_p05_gt_zero": true,
    "conditional_component_dominant_if_bootstrap_difference_p95_lt_zero": true,
    "otherwise": "MIXED_OR_UNCERTAIN",
    "difference_definition": "direct_total_nll_minus_conditional_D_given_true_T_nll",
    "secondary_relative_skill": "1 - model_nll / empirical_baseline_nll"
  },
  "governance": {
    "research_only": true,
    "formal_weight": 0,
    "new_data_collection": false,
    "provider_requests": 0,
    "market_features_used": false,
    "current_match_use": false,
    "protected_blind_access": 0,
    "manual_probability_input": false,
    "threshold_selection_on_fixed200": false,
    "formal_model_mutation": false,
    "formal_data_mutation": false,
    "formal_config_mutation": false,
    "current_mutation": false,
    "main_mutation": false
  }
}
