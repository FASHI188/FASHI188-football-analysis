{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v511_forward_freeze_event_r27.schema.json",
  "title": "Football V5.1.1 Forward Freeze Event R27",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "event_timestamp_utc",
    "previous_event_hash",
    "payload",
    "event_hash"
  ],
  "properties": {
    "schema_version": {"const": "v511_forward_freeze_event_r27.1"},
    "event_type": {"const": "PREMATCH_DECISION_FROZEN"},
    "event_timestamp_utc": {"type": "string", "format": "date-time"},
    "previous_event_hash": {
      "type": "string",
      "pattern": "^(GENESIS|[0-9a-f]{64})$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_identity",
        "decision_freeze_at_utc",
        "market",
        "context",
        "governance"
      ],
      "properties": {
        "fixture_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "competition_id",
            "round_or_stage",
            "kickoff_at_utc",
            "home_team",
            "away_team",
            "venue_type",
            "two_legged",
            "settlement_scope"
          ],
          "properties": {
            "competition_id": {"type": "string", "minLength": 1},
            "round_or_stage": {"type": "string", "minLength": 1},
            "kickoff_at_utc": {"type": "string", "format": "date-time"},
            "home_team": {"type": "string", "minLength": 1},
            "away_team": {"type": "string", "minLength": 1},
            "venue_type": {"enum": ["home", "neutral", "unknown"]},
            "two_legged": {"type": "boolean"},
            "first_leg_state": {"type": ["string", "null"]},
            "settlement_scope": {"const": "90_minutes_including_stoppage"}
          }
        },
        "decision_freeze_at_utc": {"type": "string", "format": "date-time"},
        "market": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed_at_utc",
            "available_at_utc",
            "provider_name",
            "provider_group",
            "source_identifier",
            "one_x_two",
            "asian_handicap",
            "over_under"
          ],
          "properties": {
            "observed_at_utc": {"type": "string", "format": "date-time"},
            "available_at_utc": {"type": "string", "format": "date-time"},
            "provider_name": {"type": "string", "minLength": 1},
            "provider_group": {"type": "string", "minLength": 1},
            "source_identifier": {"type": "string", "minLength": 1},
            "one_x_two": {"$ref": "#/$defs/oneXTwo"},
            "asian_handicap": {"$ref": "#/$defs/asianHandicap"},
            "over_under": {"$ref": "#/$defs/overUnder"}
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed_at_utc",
            "available_at_utc",
            "source",
            "availability",
            "predicted_xi",
            "task_state"
          ],
          "properties": {
            "observed_at_utc": {"type": "string", "format": "date-time"},
            "available_at_utc": {"type": "string", "format": "date-time"},
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_name", "source_identifier", "provider_group"],
              "properties": {
                "source_name": {"type": "string", "minLength": 1},
                "source_identifier": {"type": "string", "minLength": 1},
                "provider_group": {"type": "string", "minLength": 1}
              }
            },
            "availability": {"$ref": "#/$defs/twoSides"},
            "predicted_xi": {"$ref": "#/$defs/twoSides"},
            "task_state": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "home_objective",
                "away_objective",
                "competition_state",
                "evidence"
              ],
              "properties": {
                "home_objective": {"type": "string", "minLength": 1},
                "away_objective": {"type": "string", "minLength": 1},
                "competition_state": {"type": "string", "minLength": 1},
                "evidence": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "governance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "market_observed_no_later_than_freeze",
            "context_observed_no_later_than_freeze",
            "freeze_before_kickoff",
            "three_markets_synchronized",
            "probability_mutation",
            "formal_weight"
          ],
          "properties": {
            "market_observed_no_later_than_freeze": {"const": true},
            "context_observed_no_later_than_freeze": {"const": true},
            "freeze_before_kickoff": {"const": true},
            "three_markets_synchronized": {"const": true},
            "probability_mutation": {"const": false},
            "formal_weight": {"const": 0}
          }
        }
      }
    },
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time"},
    "price": {"type": "number", "exclusiveMinimum": 1},
    "oneXTwo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at_utc", "home", "draw", "away"],
      "properties": {
        "observed_at_utc": {"$ref": "#/$defs/timestamp"},
        "home": {"$ref": "#/$defs/price"},
        "draw": {"$ref": "#/$defs/price"},
        "away": {"$ref": "#/$defs/price"}
      }
    },
    "asianHandicap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at_utc", "line", "home", "away"],
      "properties": {
        "observed_at_utc": {"$ref": "#/$defs/timestamp"},
        "line": {"type": "number"},
        "home": {"$ref": "#/$defs/price"},
        "away": {"$ref": "#/$defs/price"}
      }
    },
    "overUnder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at_utc", "line", "over", "under"],
      "properties": {
        "observed_at_utc": {"$ref": "#/$defs/timestamp"},
        "line": {"type": "number", "minimum": 0},
        "over": {"$ref": "#/$defs/price"},
        "under": {"$ref": "#/$defs/price"}
      }
    },
    "twoSides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "away"],
      "properties": {
        "home": {
          "oneOf": [
            {"type": "array", "items": {"type": "string"}},
            {"const": "UNKNOWN"}
          ]
        },
        "away": {
          "oneOf": [
            {"type": "array", "items": {"type": "string"}},
            {"const": "UNKNOWN"}
          ]
        }
      }
    }
  }
}
