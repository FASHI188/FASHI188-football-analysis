{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FASHI188/FASHI188-football-analysis/football-data/schemas/gpt_fact_evidence_bundle_v1.schema.json",
  "title": "GPT Fact Evidence Bundle V1",
  "type": "object",
  "required": [
    "schema_version",
    "observed_at_utc",
    "repository",
    "pull_request",
    "workflow",
    "jobs",
    "artifacts",
    "research",
    "formal_boundary",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": "GPT-FACT-EVIDENCE-BUNDLE-V1"},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "repository": {"$ref": "#/$defs/identityEvidence"},
    "pull_request": {"$ref": "#/$defs/identityEvidence"},
    "workflow": {"$ref": "#/$defs/identityEvidence"},
    "jobs": {"type": "array", "items": {"$ref": "#/$defs/identityEvidence"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/identityEvidence"}},
    "research": {"type": "object"},
    "formal_boundary": {"type": "object"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "claim_type", "classification"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "claim_type": {
            "enum": [
              "EXACT_HEAD",
              "PR_STATE",
              "WORKFLOW_EXECUTION",
              "JOB_EXECUTION",
              "ARTIFACT_IDENTITY",
              "SCIENTIFIC_GATE",
              "METRIC_VALUE",
              "HOLDOUT_ACCESS",
              "FORMAL_BOUNDARY",
              "REPORTED_TEXT",
              "INFERENCE",
              "UNKNOWN_FACT"
            ]
          },
          "classification": {"enum": ["VERIFIED", "REPORTED_NOT_VERIFIED", "INFERRED", "UNKNOWN"]}
        }
      }
    }
  },
  "$defs": {
    "identityEvidence": {
      "type": "object",
      "required": ["observed_at_utc", "provenance", "raw_payload_sha256"],
      "properties": {
        "observed_at_utc": {"type": "string", "format": "date-time"},
        "provenance": {"enum": ["LIVE_API", "LOCAL_RECOMPUTATION", "SIGNED_ARTIFACT", "REPORTED_TEXT"]},
        "raw_payload_sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}
      }
    }
  }
}
