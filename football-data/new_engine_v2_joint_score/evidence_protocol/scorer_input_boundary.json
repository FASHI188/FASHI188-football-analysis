{
  "schema_version": "football3-v2-scorer-input-boundary-v1",
  "scorer": "score_unseal.py",
  "pre_unseal_allowed_inputs": [
    "verified_blind_freeze_artifact_bytes",
    "verified_blind_freeze_manifest",
    "frozen_blind_prediction_bytes",
    "frozen_final_feature_bytes",
    "frozen_engine_state_bytes",
    "frozen_universe_manifest_without_opening_label_payload"
  ],
  "pre_unseal_forbidden_inputs": [
    "final_label_payload",
    "actual_outcome",
    "home_goals",
    "away_goals",
    "result"
  ],
  "label_read_gate": {
    "artifact_upload_succeeded": true,
    "live_artifact_metadata_reread": true,
    "artifact_id_name_digest_size_recorded": true,
    "downloaded_zip_sha256_matches_metadata_digest": true,
    "zip_crc_passed": true,
    "manifest_identity_verified": true,
    "payload_sha_bytes_exact": true,
    "missing_count": 0,
    "mismatch_count": 0,
    "extra_count": 0
  },
  "labels_may_be_opened_only_after_all_gate_conditions": true
}
