{
  "schema_version": "football3-v2-predictor-input-contract-v1",
  "predictor": "blind_predict.py",
  "allowed_feature_fields": [
    "fixture_id",
    "competition_id",
    "season",
    "cutoff",
    "home_team_id",
    "away_team_id",
    "round_index"
  ],
  "allowed_non_feature_inputs": [
    "frozen_engine_state",
    "frozen_final_model_lock"
  ],
  "forbidden_label_fields": [
    "actual_outcome",
    "home_goals",
    "away_goals",
    "result",
    "result_label",
    "target_label",
    "final_label"
  ],
  "labels_must_remain_sealed": true,
  "prediction_output_must_be_persisted_before_unseal": true
}
