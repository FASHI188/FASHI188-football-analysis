GAME_RE = re.compile(r"^(?P<home>.+?) vs\. (?P<away>.+?) (?P<h>\d+):(?P<a>\d+)$")


def file_sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def git_blob_sha1(path: Path) -> str:
    payload = path.read_bytes()
    return hashlib.sha1(f"blob {len(payload)}\0".encode("ascii") + payload).hexdigest()


def interval_idx(minute_base: int) -> int:
    m = int(minute_base)
    if m <= 15:
        return 0
    if m <= 30:
        return 1
    if m <= 45:
        return 2
    if m <= 60:
        return 3
    if m <= 75:
        return 4
    return 5


def minute_base(raw: Any) -> int:
    text = str(raw).strip()
    return int(text.split("+", 1)[0])


def poisson_tail_pmf(lam: float, max_count: int = 4) -> np.ndarray:
    # Preserve the exact original R34 behavior: exact 0..3 plus one 4+ tail cell,
    # while the historical receipt labels the numerical tail as "3+".
    lam = float(np.clip(lam, 1e-9, LAMBDA_CAP))
    ps = [math.exp(-lam) * lam**k / math.factorial(k) for k in range(max_count)]
    ps.append(max(0.0, 1.0 - sum(ps)))
    arr = np.array(ps, dtype=float)
    arr /= arr.sum()
    return arr


def load_market(path: Path, season_prefix: str) -> tuple[pd.DataFrame, pd.DataFrame]:
    odds = pd.read_csv(path)
    required = [
        "Date", "HomeTeam", "AwayTeam", "FTHG", "FTAG", "FTR",
        "AvgCH", "AvgCD", "AvgCA", "AvgC>2.5", "AvgC<2.5",
    ]
    missing = [column for column in required if column not in odds.columns]
    if missing:
        raise ValueError(f"market file missing columns: {missing}")
    if len(odds) != 380:
        raise ValueError(f"expected 380 market rows, got {len(odds)}")
    odds = odds.copy().reset_index(drop=True)
    odds["date"] = pd.to_datetime(odds["Date"], dayfirst=True)
    odds["local_match_id"] = [f"{season_prefix}_{i:03d}" for i in range(1, 381)]
    odds["home_team_local"] = odds["HomeTeam"]
    odds["away_team_local"] = odds["AwayTeam"]
    odds["ft_home"] = odds["FTHG"].astype(int)
    odds["ft_away"] = odds["FTAG"].astype(int)
    manifest = odds[[
        "local_match_id", "date", "home_team_local", "away_team_local", "ft_home", "ft_away"
    ]].copy()
    inv = np.column_stack([1 / odds.AvgCH, 1 / odds.AvgCD, 1 / odds.AvgCA])
    probs = inv / inv.sum(axis=1, keepdims=True)
    ou = np.column_stack([1 / odds["AvgC>2.5"], 1 / odds["AvgC<2.5"]])
    ou = ou / ou.sum(axis=1, keepdims=True)
    market = pd.DataFrame({
        "local_match_id": odds.local_match_id,
        "date": odds.date,
        "home_team": odds.HomeTeam,
        "away_team": odds.AwayTeam,
        "pH": probs[:, 0],
        "pD": probs[:, 1],
        "pA": probs[:, 2],
        "pO25": ou[:, 0],
    })
    market["market_edge"] = market.pH - market.pA
    return manifest, market


def reconstruct_2324_counts(
    raw_goal_path: Path, manifest: pd.DataFrame
) -> tuple[dict[tuple[str, int], list[int]], pd.DataFrame, dict[str, Any]]:
    raw = pd.read_csv(raw_goal_path)
    raw = raw[raw.season.astype(str).eq("2023-2024")].copy().reset_index()
    if len(raw) != 1246:
        raise ValueError(f"expected 1246 2023/24 goal rows, found {len(raw)}")
    raw["date"] = pd.to_datetime(raw["date"])

    parsed = []
    for _, row in raw.iterrows():
        match = GAME_RE.match(str(row.game))
        if not match:
            raise ValueError(f"unparseable source game: {row.game!r}")
        source_home = match.group("home")
        source_away = match.group("away")
        if source_home not in SOURCE_TO_LOCAL or source_away not in SOURCE_TO_LOCAL:
            raise ValueError(f"unmapped source teams: {source_home!r}, {source_away!r}")
        home = SOURCE_TO_LOCAL[source_home]
        away = SOURCE_TO_LOCAL[source_away]
        final_home = int(match.group("h"))
        final_away = int(match.group("a"))
        scoring_team = SOURCE_TO_LOCAL.get(str(row.scoring_team))
        if scoring_team is None:
            raise ValueError(f"unmapped scoring team: {row.scoring_team!r}")
        if scoring_team == home:
            side = "H"
        elif scoring_team == away:
            side = "A"
        else:
            raise ValueError(f"credited team not in fixture: {row.game!r}, {row.scoring_team!r}")
        parsed.append({
            "source_line": int(row["index"]) + 2,
            "date": row.date,
            "home_team": home,
            "away_team": away,
            "final_home": final_home,
            "final_away": final_away,
            "minute_raw": str(row.time),
            "minute_base": minute_base(row.time),
            "team_side": side,
            "gh_after": int(row.GH),
            "ga_after": int(row.GA),
            "game": str(row.game),
        })
    events = pd.DataFrame(parsed)

    fixture_lookup = manifest.set_index(
        ["date", "home_team_local", "away_team_local", "ft_home", "ft_away"]
    )["local_match_id"]
    local_ids = []
    for row in events.itertuples(index=False):
        key = (row.date, row.home_team, row.away_team, row.final_home, row.final_away)
        try:
            local_ids.append(fixture_lookup.loc[key])
        except KeyError as exc:
            raise ValueError(f"event fixture not found in market manifest: {key}") from exc
    events["local_match_id"] = local_ids

    # Source order is the event order. Audit every transition and final score.
    for mid, group in events.groupby("local_match_id", sort=False):
        group = group.sort_values("source_line")
